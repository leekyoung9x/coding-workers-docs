# Cấu hình OpenRouter cho muse-shim trên macOS Workstation
# Copy file này thành ~/.config/muse/env và điền API key thật:
# cp env.template ~/.config/muse/env && chmod 600 ~/.config/muse/env

MUSE_SHIM_PROVIDER=generic
MUSE_SHIM_MODEL=meta/muse-spark-1.3-contributor
MUSE_SHIM_UPSTREAM=https://openrouter.ai/api/v1
MUSE_SHIM_PORT=8787
MUSE_SHIM_HOST=127.0.0.1

# Điền OpenRouter API key của bạn vào đây:
MUSE_SHIM_API_KEY=sk-or-v1-YOUR_KEY_HERE
